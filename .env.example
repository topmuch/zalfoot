# ============================================================
#  Zalfoot — variables d'environnement
#  Copier ce fichier en `.env` pour le développement local :
#    cp .env.example .env
# ============================================================

# Base de données SQLite (chemin relatif au dossier prisma/ pour Prisma CLI)
DATABASE_URL=file:../db/custom.db

# Port du serveur de production (conteneur Docker) — 3000 par défaut
# PORT=3000

# URL publique du site (SEO : canonical, OpenGraph, JSON-LD, sitemap, robots)
# En production Coolify : onglet Environment → SITE_URL=https://votre-domaine.tld
# SITE_URL=https://zalfoot.com

# (Optionnel) Code de vérification Google Search Console
# GOOGLE_SITE_VERIFICATION=votre-code
